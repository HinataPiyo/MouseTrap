.return_number_button {
    background-image: url("project://database/Assets/Sprites/UI/UIG.png?fileID=-7988591320785447965&guid=740b2f0e03ce966428a9a27f94f3373b&type=3#UIG_55");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    font-size: 76px;
    -unity-text-align: middle-center;
    -unity-font-definition: resource('FlatSkin/Font/Roboto-Medium');
    color: rgb(238, 215, 113);
    width: 123px;
    height: 269px;
    margin-top: 13px;
    margin-right: 13px;
    margin-bottom: 13px;
    margin-left: 13px;
    transition-duration: 0.1s;
}

