.book_selecter_button {
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/Sprites/UI/UIG.png?fileID=-8128898952994788083&guid=740b2f0e03ce966428a9a27f94f3373b&type=3#UIG_64");
    -unity-background-scale-mode: scale-to-fit;
    width: 120px;
    height: 300px;
    rotate: 30deg;
    transition-duration: 0.1s;
    scale: 0.9 0.9;
}

.book_selecter_button:hover {
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/Sprites/UI/UIG.png?fileID=-8128898952994788083&guid=740b2f0e03ce966428a9a27f94f3373b&type=3#UIG_64");
    -unity-background-scale-mode: scale-to-fit;
    width: 120px;
    height: 300px;
    rotate: 0;
    transition-duration: 0.1s;
    translate: 0 -100px;
    transition-timing-function: ease;
    scale: 1.1 1.1;
}

.book_selecter_button:active {
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/Sprites/UI/UIG.png?fileID=-8128898952994788083&guid=740b2f0e03ce966428a9a27f94f3373b&type=3#UIG_64");
    -unity-background-scale-mode: scale-to-fit;
    width: 120px;
    height: 300px;
    rotate: 0;
    transition-duration: 0.1s;
    translate: 0 -100px;
    transition-timing-function: ease;
    scale: 0.99 0.99;
}

