.base-icon {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(255, 255, 255, 0);
    width: 110px;
    height: 110px;
    margin-top: 3px;
    margin-right: 3px;
    margin-bottom: 3px;
    margin-left: 3px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-image: url("project://database/Assets/Sprites/UI/TalkView.png?fileID=-7846595335388215806&guid=cb9716b6832a7494c90186580ec66631&type=3#TalkView_1");
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.1s;
    scale: 1 1;
    translate: 0 0;
}

.select-icon {
    transition-duration: 0.1s;
    scale: 1.1 1.1;
    translate: -10px 0;
}
