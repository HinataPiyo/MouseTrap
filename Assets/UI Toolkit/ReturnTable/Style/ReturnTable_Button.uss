.button {
    background-image: url("project://database/Assets/Sprites/UI/UIK.png?fileID=3764585755344754602&guid=e861940621d455840af077ff5e740b7a&type=3#UIK_17");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    width: 240px;
    height: 240px;
    transition-duration: 0.1s;
}

.button:hover {
    background-image: url("project://database/Assets/Sprites/UI/UIK.png?fileID=3764585755344754602&guid=e861940621d455840af077ff5e740b7a&type=3#UIK_17");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    width: 240px;
    height: 240px;
    transition-duration: 0.1s;
    scale: 1.05 1.05;
}

.button:active {
    background-image: url("project://database/Assets/Sprites/UI/UIK.png?fileID=3764585755344754602&guid=e861940621d455840af077ff5e740b7a&type=3#UIK_17");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    width: 240px;
    height: 240px;
    transition-duration: 0.1s;
    scale: 0.99 0.99;
}
