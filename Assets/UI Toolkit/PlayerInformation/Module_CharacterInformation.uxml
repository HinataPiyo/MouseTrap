                <ui:VisualElement name="image" style="flex-grow: 1; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Sprites/UI/UIB.png?fileID=-3602569068832979755&amp;guid=cea2f7bf118845944b6eb823e1884c0c&amp;type=3#UIB_6&quot;);" />
                <ui:VisualElement name="special-skill-icon" style="position: absolute; top: 15px; right: 20px; background-image: url(&quot;project://database/Assets/Sprites/UI/UIB.png?fileID=4444780038281957595&amp;guid=cea2f7bf118845944b6eb823e1884c0c&amp;type=3#UIB_1&quot;); width: 65px; height: 65px; -unity-background-scale-mode: scale-to-fit;" />
