  - character: {fileID: 5151397350593897098, guid: 29203e436f9a4ad49bfcc223727a6d76, type: 3}
    characterName: 0
    body: "\u305D\u3046\u3060\u306D\u3001\u3053\u306E\u5199\u771F\u304C\u3069\u3046\u3057\u305F\u306E\uFF1F"
