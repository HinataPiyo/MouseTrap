  - character: {fileID: 8175943017069174242, guid: 911ff9a22bee52f4f9b3f468be9ab3d2, type: 3}
    characterName: 1
    body: "\u306A\u3093\u3068\u306A\u304F\u304D\u306B\u306A\u3063\u3066\u3001\u307B\u3057\u3044\u3068\u304B\u3058\u3083\u306A\u3044\u3088\uFF1F\u3082\u3061\u308D\u3093\u5E30\u308B\u3068\u304D\u306B\u306F\u8FD4\u3059\u3088"
