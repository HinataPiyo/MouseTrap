  - character: {fileID: 2144099334268728396, guid: 911ff9a22bee52f4f9b3f468be9ab3d2, type: 3}
    characterName: 1
    body: "\u4F55\u3067\u3053\u3053\u306B\u5199\u771F\u304C\u3042\u308B\u3093\u3060\u308D\u3046\u3001\u3053\u306E\u5199\u771F\u3063\u3066\u5BB6\u65CF\u3067\u64AE\u308B\u5199\u771F\u307F\u305F\u3044\u306A\u3082\u306E\u3060\u3088\u306D\uFF1F"
    delay: 0
  - character: {fileID: 2282607180949004932, guid: 911ff9a22bee52f4f9b3f468be9ab3d2, type: 3}
    characterName: 1
    body: "\u305D\u3093\u306A\u5927\u4E8B\u306A\u3082\u306E\u3092\u306A\u3093\u3067\u3053\u3053\u306B\u7F6E\u3044\u3066\u3044\u3063\u305F\u3093\u3060\u308D\u3046\u3068\u304A\u3082\u3063\u3066"
    delay: 0
  - character: {fileID: -3120352943480090939, guid: 29203e436f9a4ad49bfcc223727a6d76, type: 3}
    characterName: 0
    body: "\u78BA\u304B\u306B\u305D\u3046\u3060\u306D\u3001\u4F55\u304B\u7406\u7531\u304C\u3042\u3063\u305F\u306E\u304B\u3082\u306D"
