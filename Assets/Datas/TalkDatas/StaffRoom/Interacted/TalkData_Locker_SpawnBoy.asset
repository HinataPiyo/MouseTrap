  - character: {fileID: 2282607180949004932, guid: 911ff9a22bee52f4f9b3f468be9ab3d2, type: 3}
    characterName: 1
    body: "\u3060\u3063\u3066\u3053\u3053\u8584\u6697\u3044\u3058\u3083\u3093\u3001\u304A\u5316\u3051\u304C\u51FA\u3066\u304D\u305D\u3046\u3060\u304B\u3089\u4E00\u4EBA\u306F\u6016\u304F\u3066"
