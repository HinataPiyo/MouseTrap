    characterName: 1
    body: "\u30ED\u30C3\u30AB\u30FC\u306E\u4E2D\u3082\u771F\u3063\u6697\u3060\u3063\u305F\u304B\u3089\u898B\u3064\u3051\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068!"
