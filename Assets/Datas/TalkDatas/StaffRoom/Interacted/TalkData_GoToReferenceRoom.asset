  - character: {fileID: -4350108964438281031, guid: 29203e436f9a4ad49bfcc223727a6d76, type: 3}
    characterName: 0
    body: "\u3069\u3053\u306B\u3042\u3063\u305F\u306E\uFF1F"
    delay: 0
  - character: {fileID: 825814076350795554, guid: 911ff9a22bee52f4f9b3f468be9ab3d2, type: 3}
    characterName: 1
    body: "\u3053\u306E\u90E8\u5C4B\u306E\u5965\u306E\u65B9\u3060\u3088\u3001\u4F55\u306E\u9375\u304B\u306F\u308F\u304B\u3089\u306A\u304B\u3063\u305F\u3093\u3060\u3001\u52DD\u624B\u306B\u4F7F\u3063\u3066\u3044\u3044\u306E\u304B\u306A\u3063\u3066\u601D\u3063\u3066"
    delay: 0
  - character: {fileID: -387308690382296244, guid: 29203e436f9a4ad49bfcc223727a6d76, type: 3}
    characterName: 0
    body: "\u3058\u3083\u3042\u898B\u3066\u307F\u3088\u3046\u304B\u3001\u672C\u5F53\u304C\u4EBA\u306E\u3082\u306E\u3092\u52DD\u624B\u306B\u4F7F\u3063\u305F\u308A\u898B\u305F\u308A\u3057\u3061\u3083\u3060\u3081\u3060\u3051\u3069\u4F55\u304B\u3042\u3063\u305F\u6642\u306E\u3053\u3068\u3092\u8003\u3048\u3066"
