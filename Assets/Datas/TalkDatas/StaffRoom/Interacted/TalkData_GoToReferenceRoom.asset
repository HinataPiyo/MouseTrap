  - character: {fileID: -937643186310742431, guid: 911ff9a22bee52f4f9b3f468be9ab3d2, type: 3}
    characterName: 1
    body: "\u3053\u3053\u306F\u9375\u304C\u304B\u304B\u3063\u3066\u306A\u304B\u3063\u305F\u304B\u3089\u50D5\u306F\u3053\u3053\u306B\u96A0\u308C\u305F\u3093\u3060\u3051\u3069\u3001\u591A\u5206\u4ED6\u306E\u4E09\u4EBA\u306F\u9375\u3092\u4F7F\u3063\u3066\u305D\u3046\u3060\u306A\u3068\u601D\u3063\u3066\u3001"
    delay: 0
  - character: {fileID: 2144099334268728396, guid: 911ff9a22bee52f4f9b3f468be9ab3d2, type: 3}
    characterName: 1
    body: "\u5B9F\u306F\u96A0\u308C\u308B\u524D\u307F\u3093\u306A\u3067\u3053\u3053\u306B\u6765\u305F\u3093\u3060\u3051\u3069\u3001\u305D\u306E\u6642\u4E09\u4EBA\u304C\u8A00\u3063\u3066\u305F\u3093\u3060\u3088\u306D"
    delay: 0
  - character: {fileID: 825814076350795554, guid: 911ff9a22bee52f4f9b3f468be9ab3d2, type: 3}
    characterName: 1
    body: "\u3053\u3053\u306F\u5E83\u3044\u304B\u3089\u5B66\u6821\u307F\u305F\u3044\u306B\u4E00\u3064\u4E00\u3064\u9375\u304C\u3042\u308A\u305D\u3046\u3068\u304B\u3001\u63A2\u691C\u3057\u305F\u3044\u3068\u304B"
    delay: 0
  - character: {fileID: -937643186310742431, guid: 911ff9a22bee52f4f9b3f468be9ab3d2, type: 3}
    characterName: 1
    body: "\u9375\u306E\u3053\u3068\u8A00\u3063\u3066\u305F\u304B\u3089\u591A\u5206\u9375\u304C\u306A\u3044\u3068\u5165\u308C\u306A\u3044\u3068\u3053\u308D\u306B\u3082\u63A2\u3057\u306B\u884C\u304B\u306A\u3044\u3068\u304B\u3082"
    delay: 0
  - character: {fileID: -4350108964438281031, guid: 29203e436f9a4ad49bfcc223727a6d76, type: 3}
    characterName: 0
    body: "\u591A\u5206\u9375\u3092\u4F7F\u3063\u305F\u3068\u3057\u3066\u3082\u5185\u5074\u304B\u3089\u9589\u3081\u308B\u3053\u3068\u306F\u306A\u3044\u3093\u3058\u3083\u306A\u3044\u304B\u306A?"
    delay: 0
  - character: {fileID: 4863933739561941715, guid: 29203e436f9a4ad49bfcc223727a6d76, type: 3}
    characterName: 0
    body: "\u3060\u3063\u3066\u305D\u308C\u3060\u3068\u305A\u308B\u3057\u305F\u3053\u3068\u306B\u306A\u308B\u304B\u3089\u306D?"
    delay: 0
  - character: {fileID: -3120352943480090939, guid: 29203e436f9a4ad49bfcc223727a6d76, type: 3}
    characterName: 0
    body: "\u3067\u3082\u4E00\u5FDC\u6301\u3063\u3066\u884C\u3063\u3068\u3053\u3046\u304B"
